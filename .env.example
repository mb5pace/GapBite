# Names only. Never put real values in this file, and never commit .env.local.
# Real values go in Vercel: Project Settings > Environment Variables (Production and Preview).
# For local dev, run `vercel env pull .env.local`.

# Five permanent access codes for the team's own devices, comma separated
QX_PERMANENT_CODES=

# Cafe portal password
QX_CAFE_PASSWORD=

# Admin portal password
QX_ADMIN_PASSWORD=

# 32+ random characters, signs the session cookie
QX_SESSION_SECRET=

# Set automatically by the Upstash for Redis integration in the Vercel Marketplace.
# A database made directly on Upstash uses the UPSTASH_REDIS_REST_* names instead; both work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
